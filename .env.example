PORT=3000

# Vapi Keys
VAPI_API_PUBLIC_KEY=
VAPI_API_PRIVATE_KEY=
VAPI_WEBHOOK_SECRET=

# Assistant IDs (one per vertical)
VAPI_ASSISTANT_ID_CUSHLABS=
VAPI_ASSISTANT_ID_COACHING=
VAPI_ASSISTANT_ID_MEDSPA=
VAPI_ASSISTANT_ID_TRADES=
VAPI_ASSISTANT_ID_REALESTATE=

# Vapi Phone
VAPI_PHONE_NUMBER_ID=

# LLM Provider
GROQ_API_KEY=

# Voice Provider
CARTESIA_API_KEY=

# Database (Neon Postgres)
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# Redis (use redis://redis:6379 in Docker)
REDIS_URL=redis://localhost:6379

# Coach email for calendar invites
COACH_EMAIL=

# Google Search Console API — for sitemap submission via `pnpm seo:gsc`.
# Base64-encoded service-account JSON. Service account must be Owner of
# sc-domain:voice.cushlabs.ai (handled by the shared seo-automation-489217
# service account; copy the value from the cushlabs repo's .env.local).
GOOGLE_SA_KEY_BASE64=
