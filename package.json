{
  "name": "cushlabs-ai-voice-agent",
  "version": "2.0.0",
  "description": "Production-ready AI voice agents for lead qualification, appointment booking, and customer conversations — powered by Vapi, Claude, and Google Calendar",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --experimental-vm-modules --test test/*.test.js",
    "seo:indexnow": "node scripts/seo/indexnow-submit.mjs",
    "seo:gsc": "node scripts/seo/gsc-submit-urls.mjs --sitemap",
    "seo:gsc:url": "node scripts/seo/gsc-submit-urls.mjs --url",
    "seo:submit": "pnpm run seo:indexnow && pnpm run seo:gsc"
  },
  "keywords": [
    "ai",
    "voice-agent",
    "vapi",
    "conversational-ai",
    "lead-qualification",
    "appointment-booking",
    "google-calendar",
    "claude",
    "express",
    "cushlabs"
  ],
  "author": "CushLabs AI Services",
  "license": "ISC",
  "packageManager": "pnpm@10.17.0",
  "pnpm": {
    "overrides": {
      "path-to-regexp": ">=8.4.0"
    }
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@sentry/node": "^10.69.0",
    "@upstash/redis": "^1.38.2",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "googleapis": "^176.0.0"
  }
}
